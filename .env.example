# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=traffic.raw
KAFKA_TOPIC_METRICS=traffic.metrics
KAFKA_TOPIC_CONTROL=traffic.control

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=traffic
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=traffic_dev

# Spark
SPARK_WINDOW_SECONDS=10
SPARK_WATERMARK_SECONDS=2
SPARK_STARTING_OFFSETS=latest

# Karar servisi
CONTROL_MIN_INTERVAL_SECONDS=30
CONTROL_CONSECUTIVE_WINDOWS=3

# SUMO
SUMO_CONFIG=/app/sumo/scenarios/normal.sumocfg
SIM_SEED=1

